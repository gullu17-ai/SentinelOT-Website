# Override only when moving the production website to another confirmed domain.
NEXT_PUBLIC_SITE_URL=https://sentinel-ot-website-test.vercel.app
# Optional overrides: the supplied Google verification tag is already included in the website.
# Bing still requires a value supplied by its service.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set to 1 to opt a non-public deployment out of indexing. Vercel previews opt out automatically.
SENTINELOT_NOINDEX=
