# Override only when moving the production website to another confirmed domain.
NEXT_PUBLIC_SITE_URL=https://sentinel-ot-website-test.vercel.app
# Optional search-console verification values, supplied by the corresponding service.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
